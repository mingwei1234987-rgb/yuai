}
.icon-btn:hover { color: var(--text-primary); background: rgba(255,255,255,.12); }
.icon-btn svg { width: 17px; height: 17px; fill: currentColor; }
.icon-btn .ico-vol-off { display: none; }
.icon-btn.muted .ico-vol-on { display: none; }
.icon-btn.muted .ico-vol-off { display: block; }

.bar-wrap { display: flex; align-items: center; gap: 12px; width: clamp(220px, 34vw, 440px); }
.time {
  font-size: 10px;
  font-family: ui-monospace, "SF Mono", Consolas, monospace;
  color: var(--text-secondary);
  opacity: .75;
  width: 38px; text-align: center;
  font-variant-numeric: tabular-nums;
}
.bar {
  position: relative; flex: 1; height: 18px;
  display: flex; align-items: center;
  cursor: pointer;
  border-radius: 999px;
}
.bar::before {
  content: "";
  position: absolute; left: 0; right: 0; height: 4px;
  border-radius: 999px;
  background: rgba(255,255,255,.16);
}
.bar-fill {
  position: absolute; left: 0; height: 4px; width: 0%;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--c1), var(--c2));
  box-shadow: 0 0 12px color-mix(in srgb, var(--c1) 55%, transparent);
}
.bar-knob {
  position: absolute; left: 0;
  width: 12px; height: 12px;
  margin-left: -6px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 10px rgba(255,255,255,.85);
  opacity: 0;
  transition: opacity .18s, scale .15s;
}
.bar:hover .bar-knob { opacity: 1; scale: 1.2; }

.track-name { font-size: 12px; color: var(--text-secondary); white-space: nowrap; }

/* ---------- 启动提示 ---------- */
.start-mask {
  position: fixed; inset: 0; z-index: 100;
  display: grid; place-items: center;
  background: rgba(7, 7, 11, .8);
  transition: opacity .45s;
}
.start-mask.gone { opacity: 0; pointer-events: none; }
.start-inner { text-align: center; }
.start-btn {
  width: 76px; height: 76px;
  border-radius: 50%;
  border: none; cursor: pointer;
  background: var(--text-primary);
  display: grid; place-items: center;
  margin: 0 auto;
  box-shadow: 0 0 60px color-mix(in srgb, var(--c1) 45%, transparent);
  transition: transform .2s;
}
.start-btn:hover { transform: scale(1.08); }
.start-btn svg { width: 32px; height: 32px; fill: var(--bg); margin-left: 4px; }
.start-title { margin-top: 22px; font-size: 17px; font-weight: 600; }
.start-hint { margin-top: 10px; font-size: 12px; color: var(--text-secondary); letter-spacing: .06em; }

/* ---------- 自适应 ---------- */
@media (max-width: 900px) {
  .panel { top: 76px; right: 16px; translate: 0 0; }
  .panel.hidden { translate: 16px 0; }
}
@media (max-width: 720px) {
  .panel { display: none; }
  .track-name { display: none; }
  .gif-disc { width: min(27vh, 220px); height: min(27vh, 220px); }
  .orbit { width: min(30vh, 244px); height: min(30vh, 244px); }
  .ring { width: min(33vh, 266px); height: min(33vh, 266px); }
  .halo { width: min(38vh, 320px); height: min(38vh, 320px); }
  .lyric-line { font-size: 15px; }
}
